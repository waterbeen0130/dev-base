def test_cli_stdin_and_tree_mode():
    payload = {\"type\": \"FRAME\", \"name\": \"test\", \"visible\": True, \"children\": []}

    cmd = [sys.executable, SCRIPT_PATH, \"--stdin\", \"--profile\", \"basic\"]
