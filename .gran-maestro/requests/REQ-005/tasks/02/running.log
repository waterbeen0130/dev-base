+    "css.spacing": "CSS 간격",
+    "html.structure": "HTML 구조",
+    "html.semantic": "HTML 시맨틱",
+    "html.naming": "HTML 네이밍",
+    "html.image": "HTML 이미지",
+    "html.text": "HTML 텍스트",
+    "accessibility": "접근성",
+    "figma.mapping": "Figma 매핑",
+    "figma.fidelity": "Figma 충실도",
+    "process": "프로세스",
+    "enhancement.workflow": "개선 워크플로우",
