+    lines.append("")
+
+    grouped = group_by_category(rules, order_map)
+    if not grouped:
+        lines.append("생성할 규칙이 없습니다.")
+        lines.append("")
+        return "\n".join(lines).rstrip() + "\n"
+
+    for category, category_rules in grouped:
