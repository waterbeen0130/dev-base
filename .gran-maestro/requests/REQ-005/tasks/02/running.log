+    return sorted(rules, key=key)
+
+
+def group_by_category(rules: list[dict[str, Any]], order_map: dict[str, int]) -> list[tuple[str, list[dict[str, Any]]]]:
+    grouped: dict[str, list[dict[str, Any]]] = {}
+    for rule in rules:
+        category = str(rule.get("category", "misc"))
