+            severity = str(rule.get("severity", "unknown")).lower()
+            description = escape_md_cell(str(rule.get("description", "")))
+            lines.append(f"| `{rule_id}` | `{severity}` | {description} |")
+        lines.append("")
+
+        for rule in category_rules:
