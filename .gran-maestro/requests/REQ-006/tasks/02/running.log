+def _remove_ranges(source: str, ranges: list[tuple[int, int]]) -> str:
+    if not ranges:
+        return source
+    chunks: list[str] = []
+    cursor = 0
+    for start, end in sorted(ranges):
+        chunks.append(source[cursor:start])
+        cursor = end
+    chunks.append(source[cursor:])
+    return "".join(chunks)
+
