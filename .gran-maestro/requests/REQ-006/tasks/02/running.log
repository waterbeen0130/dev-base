+        if not isinstance(raw, (int, float)):
+            return None
+        if raw <= 1:
+            channels.append(max(0, min(255, int(round(raw * 255)))))
+        else:
+            channels.append(max(0, min(255, int(round(raw)))))
+    return "#{:02x}{:02x}{:02x}".format(*channels)
