+            elif lower_key == "fontfamily" and isinstance(child, str):
+                tokens.add(_normalize_css_value(child).strip("'\""))
+            tokens.update(_font_tokens_from_mapping(child))
+        return tokens
+    if isinstance(value, list):
+        for child in value:
+            tokens.update(_font_tokens_from_mapping(child))
+    return tokens
+
+
