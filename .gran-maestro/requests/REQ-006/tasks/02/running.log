+    def descend(node: Any, remaining: list[str]) -> None:
+        if not remaining:
+            values.append(node)
+            return
+        if isinstance(node, dict):
+            head = remaining[0]
+            if head in node:
+                descend(node[head], remaining[1:])
+            for child in node.values():
+                if isinstance(child, (dict, list)):
+                    descend(child, remaining)
+            return
+        if isinstance(node, list):
