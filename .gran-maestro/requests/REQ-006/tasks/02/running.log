+def no_layout_info_loss(rule: dict, ctx: ValidationContext) -> ValidationResult:
+    if not ctx.mapping:
+        return ValidationResult(rule["id"], rule["severity"], True, message="mapping_not_provided")
+    required_props: list[str] = []
