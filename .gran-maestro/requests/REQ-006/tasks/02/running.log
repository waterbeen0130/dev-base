+        tokens.update(match.lower() for match in HEX_COLOR_RE.findall(normalized))
+        return tokens
+    if isinstance(value, dict):
+        for child in value.values():
+            tokens.update(_collect_generic_tokens(child))
+        return tokens
+    if isinstance(value, list):
+        for child in value:
+            tokens.update(_collect_generic_tokens(child))
