+def no_plausible_value_fill(rule: dict, ctx: ValidationContext) -> ValidationResult:
+    combined = f"{ctx.html_text}\n{ctx.css_text}".lower()
+    for token in ("tbd", "todo", "unknown", "guess", "plausible"):
