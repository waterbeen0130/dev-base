+def _extract_root_variables(css_text: str) -> list[tuple[str, str]]:
+    root_match = re.search(r":root\s*\{(.*?)\}", css_text, re.DOTALL | re.IGNORECASE)
+    if not root_match:
+        return []
+    return re.findall(r"(--[a-zA-Z0-9_-]+)\s*:\s*([^;{}]+)", root_match.group(1))
