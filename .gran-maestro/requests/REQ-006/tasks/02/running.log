+            values.extend(_extract_css_property_values(css_text, prop))
+        return values
+    if lhs == "color":
+        values = []
+        for prop in ("color", "background", "background-color", "border-color"):
+            values.extend(_extract_css_property_values(css_text, prop))
+        return values
