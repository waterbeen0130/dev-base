+
+def multiline_ellipsis_pattern(rule: dict, ctx: ValidationContext) -> ValidationResult:
+    css_lower = ctx.css_text.lower()
+    has_ellipsis = "ellipsis" in css_lower or "line-clamp" in css_lower
+    if not has_ellipsis:
