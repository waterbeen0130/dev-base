+        if str(frame.get("layoutMode") or "").upper() == "VERTICAL" and any(prop in props for prop in ("gap", "row-gap", "column-gap")):
+            add_violation(
+                violations,
+                "column flex gap 금지",
+                frame,
+                "gap 미사용",
+                f"{', '.join(f'{prop}={props[prop].value}' for prop in ('gap', 'row-gap', 'column-gap') if prop in props)} @ {rule_label}",
