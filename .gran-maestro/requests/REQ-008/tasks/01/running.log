+    violations: list[Violation] = []
+    missing_rows: list[dict] = []
+    property_cache: dict[int, dict[str, PropertyValue]] = {}
+
+    for node in text_nodes:
+        match = match_text_node(node.get("characters", ""), candidates)
+        if match is None:
