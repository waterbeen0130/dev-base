+        missing_fields = [field for field in FONT_FIELDS if field not in properties]
+        if missing_fields:
+            add_violation(
+                violations,
+                "폰트 5필드 완결성",
+                node,
+                ", ".join(FONT_FIELDS),
+                f"missing: {', '.join(missing_fields)} @ {match.element.short_selector()}",
