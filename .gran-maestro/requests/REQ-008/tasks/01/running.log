+        number = float(raw_number)
+        if unit == "px":
+            candidates.append(number)
+        elif unit == "rem":
+            candidates.append(number * 16.0)
+        elif unit == "em":
+            base = font_size_px if font_size_px is not None else 16.0
+            candidates.append(number * base)
+        elif unit == "%":
+            if font_size_px is not None:
