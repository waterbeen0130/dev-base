+def normalize_bbox(bbox: object) -> dict[str, float] | None:
+    if not isinstance(bbox, dict):
+        return None
+    keys = ("x", "y", "w", "h")
+    normalized: dict[str, float] = {}
+    for key in keys:
+        value = bbox.get(key)
+        if not isinstance(value, (int, float)):
+            return None
+        normalized[key] = float(value)
+    return normalized
