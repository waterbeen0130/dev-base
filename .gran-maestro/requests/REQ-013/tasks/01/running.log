+
+    for index, frame in enumerate(frame_nodes):
+        node_id = frame_identifier(frame, index)
+        parent_id = frame.get("parent_id")
+        if isinstance(parent_id, str) and parent_id.strip():
+            parent_lookup[node_id] = parent_id.strip()
