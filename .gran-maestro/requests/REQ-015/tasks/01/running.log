+        if line == "PASS | - | 위반 0건 | -":
+            continue
+        if in_missing_rows:
+            if line in {"id | characters", "없음"}:
+                continue
+            parts = [part.strip() for part in raw_line.split(" | ", 1)]
+            if len(parts) == 2:
+                missing_rows.append({"id": parts[0], "characters": parts[1]})
+            continue
+        if " | " not in raw_line:
+            continue
+
+        category, node, expected, actual = [part.strip() for part in raw_line.split(" | ", 3)]
