+def _collect_data_url_ranges(css_text: str) -> list[tuple[int, int]]:
+    pattern = re.compile(r"url\(\s*data:[^)]+\)", re.IGNORECASE | re.DOTALL)
+    return [(match.start(), match.end()) for match in pattern.finditer(css_text)]
