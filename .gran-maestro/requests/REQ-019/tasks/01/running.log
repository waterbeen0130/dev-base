+def _check_line_height_tidy_ratio(rule: dict, ctx: ValidationContext) -> ValidationResult:
+    candidate_set = {round(candidate, 3) for candidate in LINE_HEIGHT_TIDY_CANDIDATES}
+    violations: list[tuple[str, str, int]] = []
