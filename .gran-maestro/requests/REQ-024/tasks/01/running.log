import json
import yaml
from pathlib import Path

rules_data = yaml.safe_load(Path('rules/rules.yaml').read_text(encoding='utf-8'))
out_rules = []
for rule in rules_data.get('rules', []):
    validation = rule.get('validation', {})
    entry = {
        'applies_to': rule.get('applies_to', []),
        'category': rule.get('category'),
        'description': rule.get('description'),
        'id': rule.get('id'),
        'severity': rule.get('severity'),
        'target': validation.get('target'),
        'type': validation.get('type'),
    }
    if 'custom_handler' in validation:
        entry['custom_handler'] = validation['custom_handler']
        entry['selector'] = f\"custom:{validation['custom_handler']}\"
    if 'pattern' in validation:
        entry['pattern'] = validation['pattern']
    if 'rationale' in rule:
        entry['rationale'] = rule['rationale']
    out_rules.append(entry)

Path('rules/validation_schema.json').write_text(
    json.dumps({'rules': out_rules, 'version': rules_data.get('schema_version', 1)}, ensure_ascii=False, indent=2) + '\\n',
    encoding='utf-8',
)
print('rules in schema', len(out_rules))
