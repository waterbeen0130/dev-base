import os, subprocess, sys
specs=['/mnt/d/dev-base/extracted/section_03_spec.json','/mnt/d/dev-base/extracted/section_04_spec.json']
roots=['/mnt/d/dev-base/output','/mnt/d/dev-base/landing','/mnt/c/Users/water/Downloads/260410_모제림_비절개랜딩/html']
pairs=[]
for root in roots:
    for dirpath, dirnames, filenames in os.walk(root):
        fn=set(filenames)
        htmls=[f for f in filenames if f.endswith('.html')]
        css_candidates=[]
        if 'common.css' in fn:
            css_candidates.append(os.path.join(dirpath,'common.css'))
        if os.path.exists(os.path.join(dirpath,'css','common.css')):
            css_candidates.append(os.path.join(dirpath,'css','common.css'))
        if not css_candidates:
            continue
        for h in htmls:
            for c in css_candidates:
                pairs.append((os.path.join(dirpath,h),c))
