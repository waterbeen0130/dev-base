+    except Exception as exc:  # pragma: no cover - defensive
+        return {
+            "total_fixed": 0,
+            "by_category": {},
+            "files_modified": [],
+            "unfixable_count": 0,
+            "dry_run": False,
+            "exit_code": 2,
+            "raw_output": str(exc),
+        }
+    finally:
+        if report_path and report_path.exists():
+            report_path.unlink(missing_ok=True)
+
+
