+            str(VALIDATE_SCRIPT),
+            "--html",
+            str(html_path),
+            "--css",
+            str(css_path),
+            "--profile",
+            "basic",
+            "--fix",
+        ],
+        text=True,
+        capture_output=True,
+        check=False,
+    )
+
+    combined = proc.stdout + "\n" + proc.stderr
+    assert "[auto-fix]" in combined
+
+    css_after = css_path.read_text(encoding="utf-8")
+    assert "999px" not in css_after
+    assert "rgb(" not in css_after.lower()
