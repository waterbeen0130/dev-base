+            tofile=f"{css_path} (after)",
+        )
+    )
+    if diff:
+        print("".join(diff), end="")
+    else:
+        print("[dry-run] no changes")
+
+
+def _has_tinycss2_support(css_text: str) -> bool:
+    if tinycss2 is None:
+        return False
+    try:  # pragma: no cover - environment dependent
