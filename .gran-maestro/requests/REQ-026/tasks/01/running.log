+.title {
+  font-size: 20px;
+  letter-spacing: 4px;
+}
+.btn,
+.btn_link
+{
+  padding: 10px 20px;
+}
+@media screen and (max-width: 768px) {
+  .card {
+    margin: 0;
+  }
+}
+.dup{color:#111}
+.dup{background:#fff}
