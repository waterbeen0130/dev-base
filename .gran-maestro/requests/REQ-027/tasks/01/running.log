+precedence:
+  description: |
+    Rule 충돌 시 우선순위는 priority(낮을수록 우선)로 결정한다.
+    priority가 같으면 severity 강도(error > warning > info > deprecated)로 비교한다.
+    둘 다 같으면 id 오름차순으로 안정적으로 정렬한다.
+  priority_defaults:
+    error: 100
+    warning: 200
+    info: 300
+    deprecated: 900
+  conflict_resolution_order:
+    - priority_asc
+    - severity_rank_desc
+    - id_asc
+
 categories:
   - css.layout
   - css.color
