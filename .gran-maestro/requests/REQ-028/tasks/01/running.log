+
+    colors = {key: value.lower() for key, value in tokens.get("colors", {}).items()}
+    assert colors
+    assert any(value == "#454545" for value in colors.values())
+
+
+def test_no_codegen_flag_backward_compat(tmp_path, monkeypatch):
