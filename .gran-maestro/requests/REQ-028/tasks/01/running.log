+def _parse_single_line_css(css_text: str) -> dict[str, str]:
+    rules: dict[str, str] = {}
+    for line in css_text.splitlines():
+        line = line.strip()
+        if not line:
+            continue
+        matched = re.match(r"^(?P<selector>[^{}]+)\{(?P<body>[^{}]*)\}$", line)
+        if matched:
+            rules[matched.group("selector").strip()] = matched.group("body").strip()
+    return rules
+
