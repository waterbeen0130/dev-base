+    css_2 = figma_section_spec.generate_base_css(result, "section_03")
+
+    assert css_1 == css_2
+    assert hashlib.sha256(css_1.encode("utf-8")).hexdigest() == hashlib.sha256(css_2.encode("utf-8")).hexdigest()
