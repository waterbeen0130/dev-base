+    def handle_starttag(self, tag: str, attrs) -> None:  # noqa: D401
+        self.counts[tag] = self.counts.get(tag, 0) + 1
+
+    def handle_startendtag(self, tag: str, attrs) -> None:  # noqa: D401
+        self.counts[tag] = self.counts.get(tag, 0) + 1
