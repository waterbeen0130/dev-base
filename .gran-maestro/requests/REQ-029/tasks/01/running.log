+
+    vector_nodes = payload.get("vector_nodes")
+    if isinstance(vector_nodes, list):
+        for node in vector_nodes:
+            ensure_null_keys(node, V2_VECTOR_NODE_NULL_KEYS)
+
+    return payload
+
