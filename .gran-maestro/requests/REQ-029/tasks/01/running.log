+    if marker in seen:
+        return
+    seen.add(marker)
+    print(
+        f"[RULES-CONFLICT] node {node_id} bypassed rule {rule_id} "
+        f"(figma: {figma_value} \u2192 applied: {applied_value})"
+    )
+
