+SCHEMA_V2_PATTERN = re.compile(r"^2(?:\.\d+\.\d+)?$")
+POLICY_1_CATEGORY = "[POLICY-1] VERTICAL frame itemSpacing must map to margin-bottom"
+V1_CATEGORIES = (
