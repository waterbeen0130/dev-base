+def ensure_null_keys(target: object, keys: tuple[str, ...]) -> None:
+    if not isinstance(target, dict):
+        return
+    for key in keys:
+        target.setdefault(key, None)
+
+
+def ensure_v2_payload_shape(payload: dict) -> dict:
