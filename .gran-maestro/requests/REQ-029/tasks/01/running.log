+SPEC_FILE_PATTERN = re.compile(r".+_spec\.json$")
+V1_SEMVER_PATTERN = re.compile(r"^1(?:\.\d+\.\d+)?$")
+V2_SEMVER_PATTERN = re.compile(r"^2(?:\.\d+\.\d+)?$")
