+            f"margin-bottom 미발견 @ {rule_display}",
+        )
+
+
+def enforce_policy2_constraints_extract_only(frame: dict) -> bool:
+    _ = frame
+    return True
+
+
+def enforce_policy3_rules_conflict_bypass(node: dict, rule_id: str, seen: set[tuple[str, str]]) -> bool:
