    \"id\": \"S:E2E\",
    \"name\": \"REQ-029 E2E Fixture\",
    \"bbox\": {
      \"x\": 0,
      \"y\": 0,
      \"w\": 100,
      \"h\": 100
    },
    \"_extra\": null
  },
