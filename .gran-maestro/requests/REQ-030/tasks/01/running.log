+            spread = round_float_3(effect.get("spread"))
+            if spread is not None:
+                item["spread"] = spread
+            blend_mode = effect.get("blendMode")
+            if isinstance(blend_mode, str) and blend_mode.strip():
+                item["blendMode"] = blend_mode.strip()
+
+        parsed.append(item)
+
+    return parsed
+
