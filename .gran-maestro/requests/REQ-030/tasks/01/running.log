+                "paddingTop": None,
+                "paddingRight": None,
+                "paddingBottom": None,
+                "paddingLeft": None,
+                "itemSpacing": None,
+                "primaryAxisAlignItems": None,
+                "counterAxisAlignItems": None,
+                "fills": "#aabbcc",
+                "fills_v2": [
+                    {
+                        "type": "GRADIENT_LINEAR",
+                        "opacity": 1.0,
+                        "gradientStops": [
+                            {"position": 0.0, "color": "#aabbcc"},
+                            {"position": 1.0, "color": "#ddeeff"},
+                        ],
+                        "gradientHandlePositions": [
