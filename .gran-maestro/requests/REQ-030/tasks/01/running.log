    module = _load_module()
    image_refs: set[str] = set()
    node = {
        "id": "1:2",
        "name": "Gradient Frame",
        "type": "FRAME",
        "fills": [
            {
                "type": "GRADIENT_LINEAR",
                "opacity": 0.9,
                "gradientStops": [
                    {"position": 0, "color": {"r": 0.6666667, "g": 0.7333333, "b": 0.8, "a": 0.5}},
                    {"position": 1, "color": {"r": 0.8666667, "g": 0.9333333, "b": 1.0, "a": 1}},
