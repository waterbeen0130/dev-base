+LOG_PATH="$(mktemp)"
+cleanup() {
+  rm -f "$LOG_PATH"
+}
+trap cleanup EXIT
+
+BASELINE_EXIT=""
+if [[ -f "$BASELINE_PATH" ]]; then
+  BASELINE_EXIT="$(python3 - "$BASELINE_PATH" <<'PY'
+import json
+import sys
+from pathlib import Path
+
+payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
