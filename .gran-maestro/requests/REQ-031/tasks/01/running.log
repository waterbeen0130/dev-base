+    if not tokens:
+        return None
+    if len(tokens) == 1:
+        return [tokens[0], tokens[0], tokens[0], tokens[0]]
+    if len(tokens) == 2:
+        return [tokens[0], tokens[1], tokens[0], tokens[1]]
