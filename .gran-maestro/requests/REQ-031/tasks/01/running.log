+def collect_text_decoration_tokens(css_text_decoration: str | None, css_text_decoration_line: str | None) -> set[str]:
+    tokens: set[str] = set()
+    for value in (css_text_decoration, css_text_decoration_line):
+        if not isinstance(value, str):
