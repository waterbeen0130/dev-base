+def border_uses_gradient(properties: dict[str, PropertyValue]) -> bool:
+    for prop in ("border-image", "border-image-source", "border"):
+        value = properties.get(prop)
+        if value and "gradient(" in value.value.lower():
+            return True
+    return False
