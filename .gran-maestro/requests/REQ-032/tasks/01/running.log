+def test_component_id_fields_are_extracted_and_default_to_null() -> None:
+    module = _load_module()
+    image_refs: set[str] = set()
+
+    with_component = module.normalize_frame_node(
+        {
+            "id": "1:10",
+            "name": "Instance",
+            "type": "FRAME",
+            "componentId": "100:200",
