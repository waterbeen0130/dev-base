+        ".hero{display:flex;flex-direction:row;background:#aabbcc;background-image:url('https://example.com/a.png');}\n",
+        encoding="utf-8",
+    )
+
+    proc = subprocess.run(
+        [sys.executable, str(FIGMA_VALIDATE), "--spec", str(spec_path), "--html", str(html_path), "--css", str(css_path)],
