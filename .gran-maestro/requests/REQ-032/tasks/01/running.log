+            if not isinstance(frame, dict):
+                continue
+            node_id = node_identifier(frame, "frame", index)
+            fills_v2 = frame.get("fills_v2")
+            if not isinstance(fills_v2, list):
+                continue
+            for fill in fills_v2:
