+
+def build_asset_manifest(payload: dict) -> dict:
+    assets: list[dict[str, str]] = []
+    image_refs_seen: set[str] = set()
+    vector_refs_seen: set[str] = set()
+
+    frame_nodes = payload.get("frame_nodes")
