+def asset_manifest_path_from_spec(spec_path: str) -> Path:
+    spec = Path(spec_path)
+    stem = spec.stem
+    if stem.endswith("_spec"):
+        base = stem[: -len("_spec")]
+    else:
+        base = stem
+    return spec.with_name(f"{base}_asset_manifest.json")
+
+
