+    assert {item["hash"] for item in image_assets} == {"img_same", "img_other"}
+
+    assert len(vector_assets) == 1
+    expected_vector_hash = hashlib.sha256("M0 0L10 10Z\nM2 2L3 3Z".encode("utf-8")).hexdigest()
