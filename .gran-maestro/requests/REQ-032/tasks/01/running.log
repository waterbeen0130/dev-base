+                    "ref": node_id,
+                    "kind": "vector",
+                    "hash": sha256_hex(path_content),
+                    "spec_node_id": node_id,
+                }
+            )
+
+    assets.sort(key=lambda item: (item["kind"], item["ref"], item["spec_node_id"], item["hash"]))
+    return {"assets": assets}
