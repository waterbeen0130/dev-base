+def test_v2_asset_manifest_missing_fails_validation(tmp_path: Path) -> None:
+    spec_payload = {
+        "schema_version": "2.0.0",
+        "section": {"id": "1:1", "name": "S", "bbox": {"x": 0, "y": 0, "w": 100, "h": 100}},
