+                "v2.assetManifest.exists",
+                f"{expected['kind']}:{expected['ref']}",
+                json.dumps(expected, ensure_ascii=False, sort_keys=True),
+                json.dumps(actual, ensure_ascii=False, sort_keys=True),
+            )
+
+    return violations
+
