+    image_refs: set[str] = set()
+
+    with_component = module.normalize_frame_node(
+        {
+            "id": "1:10",
+            "name": "Instance",
+            "type": "FRAME",
+            "componentId": "100:200",
+            "componentSetId": "100:201",
+        },
