+  if ! grep -F -- "- ${category}" "$VERSION_LOG" >/dev/null; then
+    echo "[FAIL] missing category in --version-info: ${category}" >&2
+    exit 1
+  fi
+done
+
+OUT_DEFAULT="$TMP_DIR/manifest_default"
+set +e
+run_and_capture "emit_manifest_default" \
