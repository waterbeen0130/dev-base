+def _build_violation_brief_appendix(violations: list[dict[str, Any]]) -> str:
+    if not violations:
+        return ""
+    lines = [
+        "| rule_id | file | line | expected | actual | fix_strategy | patch_hint |",
+        "| --- | --- | --- | --- | --- | --- | --- |",
