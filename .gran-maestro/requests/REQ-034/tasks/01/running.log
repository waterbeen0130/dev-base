+            return list(payload["violations"])
+        items: list[Any] = []
+        for key in ("figma_validate", "validate_semantic"):
+            nested = payload.get(key)
+            if isinstance(nested, dict) and isinstance(nested.get("violations"), list):
+                items.extend(nested["violations"])
