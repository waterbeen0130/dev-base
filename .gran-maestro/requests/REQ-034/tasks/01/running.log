+                    _escape_markdown_cell(violation.get("actual", "")),
+                    _escape_markdown_cell(violation.get("fix_strategy", "")),
+                    _escape_markdown_cell(patch_hint),
+                ]
+            )
+            + " |"
+        )
+    return "\n".join(lines)
