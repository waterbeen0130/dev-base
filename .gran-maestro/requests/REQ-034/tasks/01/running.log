+                    {
+                        "rule_id": "semantic.text_exists",
+                        "file": "landing/index.html",
+                        "line": 1,
+                        "expected": "node exists",
+                        "actual": "node missing",
+                        "fix_strategy": "manual",
+                    }
+                ]
+            },
+            ensure_ascii=False,
+            indent=2,
+        ),
+        encoding="utf-8",
+    )
+
+    proc = subprocess.run(
+        [
+            sys.executable,
+            str(REPAIR_SCRIPT),
+            "--html",
+            str(html_path),
+            "--css",
+            str(css_path),
+            "--violations",
+            str(violations_path),
+        ],
+        cwd=ROOT,
+        text=True,
+        capture_output=True,
+        check=False,
