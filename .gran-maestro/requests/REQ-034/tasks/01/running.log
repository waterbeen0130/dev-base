+                "violations": [
+                    {
+                        "rule_id": "semantic.text_exists",
+                        "file": "landing/index.html",
+                        "line": 1,
+                        "expected": "node exists",
+                        "actual": "node missing",
+                        "fix_strategy": "manual",
+                    }
+                ]
+            },
+            ensure_ascii=False,
+            indent=2,
+        ),
+        encoding="utf-8",
+    )
+
+    proc = subprocess.run(
