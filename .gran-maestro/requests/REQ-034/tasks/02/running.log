+  echo "[FAIL] migrate dry-run missing already-v2 marker for section_04_spec.json" >&2
+  exit 1
+fi
+if ! grep -F "[SUMMARY] mode=dry-run ok=2 fail=0 scanned=2" "$TMP_DIR/migrate_v1_to_v2_dry_run.log" >/dev/null; then
