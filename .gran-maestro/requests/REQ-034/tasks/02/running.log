+  fi
+
+  echo "===== ${label} ====="
+  cat "$logfile"
+  echo "[EXIT] ${label}=${ec}"
+  echo
+
+  return "$ec"
+}
+
+assert_exit_zero() {
+  local label="$1"
+  local ec="$2"
+  if [[ "$ec" -ne 0 ]]; then
+    echo "[FAIL] ${label} expected exit 0, got ${ec}" >&2
+    exit 1
+  fi
+}
+
+set +e
+run_and_capture "pytest_all" pytest tests/ -v --tb=short
+PYTEST_EC=$?
+set -e
+assert_exit_zero "pytest tests/ -v --tb=short" "$PYTEST_EC"
+
