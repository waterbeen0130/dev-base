+V2_DETAIL_COUNT="$(grep -c '^- v2\.' "$TMP_DIR/figma_validate_version_info.log" || true)"
+if [[ "$V2_DETAIL_COUNT" -ne 14 ]]; then
+  echo "[FAIL] v2 detail category count expected 14, got ${V2_DETAIL_COUNT}" >&2
+  exit 1
+fi
