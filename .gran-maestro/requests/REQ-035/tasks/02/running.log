+        passed=True,
+        skipped=True,
+        message="validated_by_figma_validate_runtime",
+    )
+
+
+PYDANTIC_POLICY_HANDLERS: dict[str, Callable[[RuleDefinition, RuleDispatchContext | None], RuleHandlerResult]] = {
