+from __future__ import annotations
+
+import subprocess
+import sys
+import os
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+STRUCTURAL_DIFF = ROOT / "tools" / "structural-diff.py"
+
+
+def _clean_env() -> dict[str, str]:
+    env = os.environ.copy()
+    for key in list(env):
+        if key.startswith("PYTEST_"):
+            env.pop(key)
+    return env
