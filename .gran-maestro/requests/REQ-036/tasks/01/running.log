+    for key in list(env):
+        if key.startswith("PYTEST_"):
+            env.pop(key)
+    return env
+
+
+def test_structural_drift_reports_tag_mismatch(tmp_path: Path) -> None:
+    spec_path = tmp_path / "spec.json"
+    html_path = tmp_path / "index.html"
