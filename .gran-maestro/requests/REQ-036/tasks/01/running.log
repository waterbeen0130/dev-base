+    result = subprocess.run(
+        [
+            sys.executable,
+            str(STRUCTURAL_DIFF),
+            "--spec",
+            str(spec_path),
+            "--html",
+            str(html_path),
+        ],
+        cwd=ROOT,
+        env=_clean_env(),
+        text=True,
+        capture_output=True,
+        check=False,
