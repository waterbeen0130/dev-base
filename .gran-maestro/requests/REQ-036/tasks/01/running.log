+            str(STRUCTURAL_DIFF),
+            "--spec",
+            str(matching_spec),
+            "--html",
+            str(matching_html),
+        ],
+        cwd=ROOT,
+        env=_clean_env(),
+        text=True,
+        capture_output=True,
+        check=False,
