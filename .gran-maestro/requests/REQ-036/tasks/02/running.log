diff --git a/tests/integration/test_post_impl_structural_diff.py b/tests/integration/test_post_impl_structural_diff.py
new file mode 100755
index 0000000000000000000000000000000000000000..2f7ac0b6f7a5c5398e5f46bc965628a9a246e717
--- /dev/null
+++ b/tests/integration/test_post_impl_structural_diff.py
@@ -0,0 +1,40 @@
+from __future__ import annotations
+
+import subprocess
+import sys
+import shutil
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+POST_IMPL_VERIFY = ROOT / "tools" / "post-impl-verify.py"
+
+
+def test_post_impl_structural_diff_reports_structural_line(tmp_path: Path) -> None:
+    html_path = tmp_path / "index.html"
+    css_path = tmp_path / "common.css"
+    shutil.copyfile(ROOT / "landing" / "index.html", html_path)
+    shutil.copyfile(ROOT / "landing" / "css" / "common.css", css_path)
+
+    result = subprocess.run(
+        [
+            sys.executable,
+            str(POST_IMPL_VERIFY),
+            "--spec",
+            "extracted/section_03_spec.json",
+            "--html",
+            str(html_path),
+            "--css",
+            str(css_path),
+            "--profile",
+            "landing",
+            "--structural-diff",
+        ],
+        cwd=ROOT,
+        text=True,
+        capture_output=True,
+        check=False,
+    )
+
+    assert result.returncode in {0, 1}
+    assert "[STRUCTURAL]" in result.stdout
