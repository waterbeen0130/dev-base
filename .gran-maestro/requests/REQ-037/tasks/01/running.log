+def test_component_group_splits_shared_style_from_scoped_overrides() -> None:
+    module = _load_module()
+    spec = {
+        "text_nodes": [
+            {
+                "id": "2:1",
+                "name": "Primary",
+                "componentId": "component:button",
+                "characters": "Buy",
+                "fontFamily": "Inter",
+                "fontSize": 16,
+                "fontWeight": 600,
