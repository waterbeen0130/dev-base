+
+
+ROOT = Path(__file__).resolve().parents[2]
+FIGMA_SECTION_SPEC = ROOT / "tools" / "figma-section-spec.py"
+
+
+def _load_module():
+    module_name = "figma_section_spec_req037_override_split"
