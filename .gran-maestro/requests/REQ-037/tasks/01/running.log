+                "color": "#111111",
+                "bbox": {"x": 0, "y": 0, "w": 100, "h": 24},
+            },
+            {
+                "id": "2:2",
+                "name": "Secondary",
+                "componentId": "component:button",
+                "characters": "Sell",
+                "fontFamily": "Inter",
+                "fontSize": 14,
+                "fontWeight": 600,
+                "lineHeightPx": 24,
+                "color": "#222222",
+                "bbox": {"x": 0, "y": 30, "w": 100, "h": 24},
+            },
+            {
+                "id": "2:3",
+                "name": "Tertiary",
+                "componentId": "component:button",
+                "characters": "Hold",
+                "fontFamily": "Inter",
+                "fontSize": 16,
+                "fontWeight": 700,
+                "lineHeightPx": 24,
+                "color": "#333333",
+                "bbox": {"x": 0, "y": 60, "w": 100, "h": 24},
+            },
+        ],
+        "frame_nodes": [],
+    }
+
+    group = module.extract_component_groups(spec)[0]
+    overrides = {override["node_id"]: override["diff"] for override in group["overrides"]}
