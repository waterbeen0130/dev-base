+def test_component_group_splits_shared_style_from_scoped_overrides() -> None:
+    module = _load_module()
+    spec = {
+        "text_nodes": [
+            {
+                "id": "2:1",
+                "name": "Primary",
+                "componentId": "component:button",
+                "characters": "Buy",
+                "fontFamily": "Inter",
+                "fontSize": 16,
+                "fontWeight": 600,
+                "lineHeightPx": 24,
+                "color": "#111111",
+                "bbox": {"x": 0, "y": 0, "w": 100, "h": 24},
+            },
+            {
+                "id": "2:2",
+                "name": "Secondary",
+                "componentId": "component:button",
+                "characters": "Sell",
+                "fontFamily": "Inter",
+                "fontSize": 14,
+                "fontWeight": 600,
+                "lineHeightPx": 24,
+                "color": "#222222",
+                "bbox": {"x": 0, "y": 30, "w": 100, "h": 24},
