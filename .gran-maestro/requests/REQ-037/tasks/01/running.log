+                "name": "Secondary",
+                "componentId": "component:button",
+                "characters": "Sell",
+                "fontFamily": "Inter",
+                "fontSize": 14,
+                "fontWeight": 600,
+                "lineHeightPx": 24,
+                "color": "#222222",
+                "bbox": {"x": 0, "y": 30, "w": 100, "h": 24},
