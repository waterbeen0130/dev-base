+    module = _load_module()
+    spec = {
+        "text_nodes": [
+            {"id": "1:1", "name": "Label A", "componentId": "component:card", "characters": "A"},
+            {"id": "1:2", "name": "Label B", "componentId": "component:card", "characters": "B"},
+            {"id": "1:3", "name": "Standalone", "componentId": "component:single", "characters": "C"},
+        ],
+        "frame_nodes": [
