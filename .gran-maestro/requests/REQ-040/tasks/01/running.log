+
+    for basename in sorted(html_basenames):
+        if not any(_asset_ref_matches_basename(ref, basename) for ref in manifest_refs):
+            add_violation(
+                violations,
+                "asset_manifest 일치",
+                basename,
+                "asset_manifest 등록 필요 (Figma 원본)",
+                "통이미지 의심 (manifest 미등록)",
+            )
+
+    return violations
+
