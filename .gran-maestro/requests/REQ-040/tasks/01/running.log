+def validate_text_byte_exact(spec: dict, html: str) -> list[Violation]:
+    violations: list[Violation] = []
+    text_nodes = spec.get("text_nodes")
+    if not isinstance(text_nodes, list):
+        return violations
+
+    for node in text_nodes:
