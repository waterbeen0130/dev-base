+
+    assert args.spec is not None
+    spec = load_spec(args.spec)
+    result = validate_spec_payload(
+        spec=spec,
+        spec_path=args.spec,
+        spec_dir=Path(args.spec).parent,
+        html_text=html_text,
+        parser=parser,
+        css_rules=css_rules,
+        text_candidates=text_candidates,
