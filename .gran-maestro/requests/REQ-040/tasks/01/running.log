+def _html_img_basenames(html: str) -> set[str]:
+    srcs = re.findall(r"<img\b[^>]*\bsrc\s*=\s*['\"]([^'\"]+)['\"]", html, flags=re.I)
+    basenames: set[str] = set()
+    for src in srcs:
+        path = urlsplit(src).path
+        stem = Path(path).stem
+        if stem:
+            basenames.add(stem)
+    return basenames
+
