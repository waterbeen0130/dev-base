+    overall: Counter[str] = Counter()
+    for result in results:
+        counts = violation_severity_counts(result.violations)
+        overall.update(counts)
+        total = sum(counts.values())
+        print(
+            f"{result.section_name} | {counts['CRITICAL']} | {counts['MAJOR']} | "
