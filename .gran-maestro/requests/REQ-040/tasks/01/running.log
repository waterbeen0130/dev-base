+def validate_asset_manifest_consistency(spec: dict, html: str, spec_dir: Path | None) -> list[Violation]:
+    manifest_path = _manifest_path_for_section(spec, spec_dir)
+    if manifest_path is None or not manifest_path.exists():
+        return []
+
+    try:
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    except Exception:  # noqa: BLE001
+        return []
+
+    manifest_refs = _manifest_image_refs(manifest)
+    html_basenames = _html_img_basenames(html)
