+            if not isinstance(violation, dict):
+                continue
+            severity = str(violation.get("severity", "MAJOR"))
+            message = str(violation.get("message", ""))
+            _append_violation_item(
+                items,
+                f"semantic.{severity.lower()}",
+                "validate-semantic",
+                severity,
+                "",
+                message,
