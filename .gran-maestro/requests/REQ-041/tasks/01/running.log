+def build_convergence_result(
+    figma_result: dict[str, object],
+    semantic_result: dict[str, object],
+    overall_exit_code: int,
+    structural_result: dict[str, object] | None = None,
+) -> dict[str, object]:
+    semantic_counts = semantic_result["counts"]
