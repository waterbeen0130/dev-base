   725	def run_convergence_loop(args: argparse.Namespace, validate_fn, dispatch_fn) -> int:
   726	    history: list[dict[str, object]] = []
   727	    prev_total: int | None = None
   728	    for i in range(1, args.max_iterations + 1):
   729	        t0 = time.time()
   730	        result = validate_fn()
   731	        duration = time.time() - t0
   732	
   733	        violations = {
   734	            "iter": i,
   735	            "critical": result["critical"],
   736	            "major": result["major"],
   737	            "minor": result["minor"],
   738	            "total": result["total"],
   739	            "duration_s": round(duration, 2),
   740	        }
   741	        history.append(violations)
   742	
   743	        print(
   744	            f"[ITER {i}] CRITICAL={result['critical']} MAJOR={result['major']} "
   745	            f"MINOR={result['minor']} TOTAL={result['total']}"
   746	        )
   747	
   748	        if args.convergence_mode == "zero-violations" and result["total"] == 0:
   749	            print(f"[CONVERGED] iter={i} zero-violations")
   750	            break
   751	        if args.convergence_mode == "no-change" and prev_total == result["total"]:
   752	            print(f"[CONVERGED] iter={i} no-change (total={result['total']})")
   753	            break
   754	        if i == args.max_iterations:
   755	            if result["total"] > 0:
   756	                print(f"[WARN] 수렴 미달성: iter={args.max_iterations} remaining={result['total']}", file=sys.stderr)
   757	            break
   758	
   759	        violations_json = write_violations_json(result, f".gran-maestro/state/iter-{i}-violations.json")
   760	        dispatch_fn(violations_json, args.dispatch_agent)
   761	
   762	        prev_total = int(result["total"])
   763	
   764	    history_path = Path(".gran-maestro/state/converge-history.json")
   765	    history_path.parent.mkdir(parents=True, exist_ok=True)
   766	    history_path.write_text(json.dumps(history, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
   767	
   768	    if history[-1]["total"] == 0:
   769	        return 0
   770	    return 1
