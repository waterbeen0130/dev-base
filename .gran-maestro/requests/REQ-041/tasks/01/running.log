+    if exit_code != 0:
+        print(f"[WARN] dispatch repair exited with {exit_code}", file=sys.stderr)
+
+
+def run_convergence_loop(args: argparse.Namespace, validate_fn, dispatch_fn) -> int:
+    history: list[dict[str, object]] = []
+    prev_total: int | None = None
