+        major += 1
+
+    total = critical + major + minor
+    payload: dict[str, object] = {
+        "critical": critical,
+        "major": major,
+        "minor": minor,
+        "total": total,
+        "exit_code": overall_exit_code,
+        "figma_validate": figma_result,
+        "validate_semantic": semantic_result,
