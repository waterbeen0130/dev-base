+    minor = int(figma_result["ignore"]) + int(semantic_counts["minor"])
+    if structural_result is not None and bool(structural_result["blocking"]):
+        major += 1
+
+    total = critical + major + minor
+    payload: dict[str, object] = {
+        "critical": critical,
+        "major": major,
+        "minor": minor,
+        "total": total,
+        "exit_code": overall_exit_code,
