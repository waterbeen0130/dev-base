+        "vector_nodes": [{"id": "1:2", "fillGeometryPathData": ["M0 0L1 1Z"], "strokeGeometryPathData": []}],
+    }
+
+
+def test_svg_download(tmp_path: Path, monkeypatch) -> None:
+    # Arrange
