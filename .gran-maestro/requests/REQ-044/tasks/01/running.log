+    assert downloads[("vector", "1:2")]["local_path"] == "hero/vectors/1_2.svg"
+    assert downloads[("vector", "1:2")]["format"] == "svg"
+    assert downloads[("vector", "1:2")]["hash"] == hashlib.sha256(svg_bytes).hexdigest()
