+            stem = Path(urlsplit(local_path).path).stem
+            if stem:
+                refs.add(stem)
+            continue
+
+        kind = asset.get("kind")
+        if isinstance(kind, str) and kind and kind != "image":
+            continue
+        ref = asset.get("image_ref")
+        if not isinstance(ref, str) or not ref:
+            ref = asset.get("ref")
+        if isinstance(ref, str) and ref:
+            refs.add(ref)
+    return refs
