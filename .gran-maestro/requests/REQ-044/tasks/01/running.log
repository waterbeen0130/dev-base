+            }
+        ]
+    }
+    (tmp_path / "hero_asset_manifest.json").write_text(json.dumps(manifest), encoding="utf-8")
+    html = '<img src="./hero/vectors/1_2.svg">'
+
+    # Act
+    violations = module.validate_asset_manifest_consistency(spec, html, tmp_path)
+
+    # Assert
+    assert violations == []
