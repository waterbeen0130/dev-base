+
+def test_download_assets_error_handling(tmp_path: Path, monkeypatch, capsys) -> None:
+    # Arrange
+    module = _load_section_module()
+
+    def fake_get(url: str, **kwargs):
+        del url, kwargs
+        return MockResponse(status_code=500, json_payload={"err": "nope"})
