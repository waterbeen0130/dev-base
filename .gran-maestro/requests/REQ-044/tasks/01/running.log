+) -> dict[tuple[str, str], dict[str, str]]:
+    """Download manifest assets via Figma images API and return manifest fields."""
+    output_root = Path(output_dir)
+    downloads: dict[tuple[str, str], dict[str, str]] = {}
+    request_groups = {
+        "vector": {
