+
+        if response.status_code == 429 and attempt < len(delays):
+            time.sleep(delays[attempt])
+            continue
+
+        if response.status_code != 200:
+            warn(f"Figma images API request failed for {export_format} ({response.status_code}); skipping assets")
+            return {}
+
+        try:
