   648	        assets = manifest
   649	    if not isinstance(assets, list):
   650	        return set()
   651	
   652	    refs: set[str] = set()
   653	    for asset in assets:
   654	        if not isinstance(asset, dict):
   655	            continue
   656	        local_path = asset.get("local_path")
   657	        if isinstance(local_path, str) and local_path:
   658	            stem = Path(urlsplit(local_path).path).stem
   659	            if stem:
   660	                refs.add(stem)
   661	            continue
   662	
   663	        kind = asset.get("kind")
   664	        if isinstance(kind, str) and kind and kind != "image":
