+
+def test_png_download(tmp_path: Path, monkeypatch) -> None:
+    # Arrange
+    module = _load_section_module()
+    png_bytes = b"\x89PNG\r\n\x1a\npayload"
+
+    def fake_get(url: str, **kwargs):
