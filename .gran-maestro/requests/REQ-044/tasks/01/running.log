    if not manifest_path.exists():
        add_violation(
            violations,
            "v2.assetManifest.exists",
            str(manifest_path),
            f"manifest exists with {len(expected_entries)} asset entries",
            "missing file",
        )
        return violations

    try:
        manifest_raw = json.loads(manifest_path.read_text(encoding="utf-8"))
