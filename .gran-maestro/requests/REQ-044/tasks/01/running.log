+def test_backward_compat() -> None:
+    # Arrange
+    module = _load_section_module()
+
+    # Act
+    manifest = module.build_asset_manifest(_payload())
+
+    # Assert
+    image_asset = next(asset for asset in manifest["assets"] if asset["kind"] == "image")
