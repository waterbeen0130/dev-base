   818	def _download_asset_url(asset_url: str, label: str) -> bytes | None:
   819	    try:
   820	        response = requests.get(asset_url, timeout=60, stream=True)
   821	    except requests.RequestException as exc:
   822	        warn(f"Asset download failed for {label}: {exc}")
   823	        return None
   824	
   825	    if response.status_code != 200:
   826	        warn(f"Asset download failed for {label} ({response.status_code})")
   827	        return None
   828	
   829	    content_length = response.headers.get("Content-Length") if hasattr(response, "headers") else None
   830	    if isinstance(content_length, str):
   831	        try:
   832	            if int(content_length) > MAX_ASSET_DOWNLOAD_BYTES:
   833	                warn(f"Asset download skipped for {label}: file exceeds 10MB")
   834	                return None
   835	        except ValueError:
   836	            pass
   837	
   838	    chunks: list[bytes] = []
   839	    total = 0
   840	    try:
   841	        iterator = response.iter_content(chunk_size=8192)
   842	    except AttributeError:
   843	        iterator = (getattr(response, "content", b""),)
   844	
   845	    for chunk in iterator:
   846	        if not chunk:
   847	            continue
   848	        total += len(chunk)
   849	        if total > MAX_ASSET_DOWNLOAD_BYTES:
   850	            warn(f"Asset download skipped for {label}: file exceeds 10MB")
   851	            return None
   852	        chunks.append(chunk)
   853	
   854	    data = b"".join(chunks)
   855	    if not data:
   856	        warn(f"Asset download skipped for {label}: empty response")
   857	        return None
   858	    return data
