      "category": "html.structure",
      "description": "DOM 최대 깊이는 5단계를 초과하지 않는다.",
      "id": "max_dom_depth",
      "severity": "warning",
      "target": "html",
      "type": "numeric_range",
      "pattern": "depth<=5",
