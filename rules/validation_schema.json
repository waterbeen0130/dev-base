        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "각 페이지의 본문 클래스는 페이지 프리픽스({페이지}_{역할}) 패턴을 따른다.",
      "id": "page_prefix_required",
      "severity": "warning",
      "target": "html",
      "type": "naming_pattern",
      "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$",
      "priority": 200
    },
