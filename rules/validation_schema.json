{
  "rules": [
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.layout",
      "description": "레이아웃은 flexbox만 사용한다 (Grid/float 금지).",
      "id": "flexbox_layout",
      "pattern": "display\\s*:\\s*grid|float\\s*:\\s*(left|right)",
      "severity": "error",
      "target": "css",
      "type": "regex_must_not_match"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.layout",
      "description": "CSS Grid는 사용하지 않는다 — flexbox 전용.",
      "id": "no_css_grid",
      "pattern": "display\\s*:\\s*grid",
      "severity": "error",
      "target": "css",
      "type": "regex_must_not_match"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.layout",
      "custom_handler": "section_width_formula",
      "description": "섹션 폭 공식 강제: --width = Figma inner content width + 40, --padding = 20px, .cont 클래스 패턴 필수, 섹션은 full-bleed + background, 너비 제한은 .cont 내부에서만.",
      "id": "section_width_formula",
      "rationale": "프로젝트마다 반복되는 실수 방지: section에 Figma inner padding(240 등)을 직접 이식해\nbackground가 가운데만 나오고 content 정렬이 깨지는 문제. 공식을 코드로 강제한다.\n\n공식:\n- :root { --width: <figma_content_width + 40>; --padding: 20px; }\n- .cont { width: 100%; max-width: var(--width); margin: 0 auto; padding: 0 var(--padding); }\n- 배경이 있는 섹션은 full-width 유지 (max-width 직접 선언 금지, .cont 하위 사용)\n- border-box 기준 .cont 내부 content = --width - 2*--padding = Figma content width\n",
      "selector": "custom:section_width_formula",
      "severity": "error",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.color",
      "description": "색상은 hex 전용 (#fff, #090944). rgb()/hsl() 금지. 투명도 필요 시만 rgba() 허용.",
      "id": "hex_color_only",
      "pattern": "(?<!rgba)\\brgb\\(|hsl\\(",
      "severity": "error",
      "target": "css",
      "type": "regex_must_not_match"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.color",
      "custom_handler": "_check_no_hex8_literal",
      "description": "8자리 hex 리터럴(#RRGGBBAA)은 사용하지 않는다 (주석 및 url(data:) 내부는 제외).",
      "id": "no_hex8_literal",
      "selector": "custom:_check_no_hex8_literal",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "custom_handler": "_check_box_sizing_redundant",
      "description": "universal reset(*, *::before, *::after) 외 box-sizing:border-box 중복 선언을 금지한다.",
      "id": "box_sizing_redundant",
      "selector": "custom:_check_box_sizing_redundant",
      "severity": "info",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "custom_handler": "_check_empty_media_block",
      "description": "@media 블록 본문이 공백/주석뿐이면 빈 블록으로 간주하고 금지한다 (@media print 예외).",
      "id": "empty_media_block",
      "selector": "custom:_check_empty_media_block",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "landing"
      ],
      "category": "css.format",
      "description": "landing 프로젝트는 [data-delay] opacity/position 룰과 .section_on 토글 룰이 있어야 한다.",
      "id": "gsap_animation_css_present",
      "pattern": "[data-delay]",
      "severity": "warning",
      "target": "css",
      "type": "required_substring"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "custom_handler": "check_media_indent",
      "description": "@media 내부 규칙은 줄바꿈 분리하되 들여쓰기 없이 작성한다. 한 줄에 모든 규칙을 이어붙이지 않는다.",
      "id": "media_query_format",
      "selector": "custom:check_media_indent",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "custom_handler": "check_important",
      "description": "!important는 사용하지 않는다 (mb_/mt_/txt_c 등 유틸리티 클래스만 예외).",
      "id": "no_important",
      "selector": "custom:check_important",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "custom_handler": "check_media_indent",
      "description": "@media 블록 내부 규칙에 들여쓰기를 사용하지 않는다.",
      "id": "no_media_indent",
      "selector": "custom:check_media_indent",
      "severity": "info",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "basic"
      ],
      "category": "css.format",
      "description": "basic 프로젝트: reset.css는 별도 파일로 분리한다.",
      "id": "reset_css_separate",
      "pattern": "reset.css",
      "severity": "warning",
      "target": "html",
      "type": "required_substring"
    },
    {
      "applies_to": [
        "common",
        "basic"
      ],
      "category": "css.format",
      "custom_handler": "check_reset_duplicate",
      "description": "common.css에 reset.css의 핵심 패턴(* margin/padding/box-sizing 등)을 중복 작성하지 않는다.",
      "id": "reset_duplicate",
      "selector": "custom:check_reset_duplicate",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "custom_handler": "check_selector_format",
      "description": "각 CSS 셀렉터 규칙은 한 줄로 작성한다 (여러 줄 펼침 금지).",
      "id": "selector_single_line",
      "selector": "custom:check_selector_format",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.units",
      "description": "100px 미만 값에는 clamp()를 사용하지 않는다 (고정 px). 100px 이상만 clamp 허용.",
      "id": "clamp_threshold",
      "pattern": "clamp\\(\\s*([0-9]|[1-9][0-9])px",
      "severity": "info",
      "target": "css",
      "type": "regex_must_not_match"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.units",
      "custom_handler": "check_clamp_under_100",
      "description": "padding/margin에 100px 미만 clamp()를 사용하지 않는다.",
      "id": "no_clamp_under_100",
      "selector": "custom:check_clamp_under_100",
      "severity": "info",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.units",
      "custom_handler": "check_raw_calc_vw",
      "description": "calc()는 clamp() 내부에서만 사용한다. 단독 사용 금지.",
      "id": "no_raw_calc",
      "selector": "custom:check_raw_calc_vw",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.units",
      "custom_handler": "check_raw_calc_vw",
      "description": "vw 단위는 clamp() 내부에서만 사용한다. 단독 사용 금지.",
      "id": "no_raw_vw",
      "selector": "custom:check_raw_calc_vw",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.variables",
      "custom_handler": "check_root_vars",
      "description": ":root{} 안의 CSS 변수는 각 줄에 하나씩 선언한다 (한 줄에 여러 변수 금지).",
      "id": "root_var_line_separated",
      "selector": "custom:check_root_vars",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.variables",
      "custom_handler": "root_var_naming",
      "description": ":root 변수는 --point-color-N, --width, --padding 같은 패턴을 따른다 (시맨틱 이름 금지).",
      "id": "root_var_naming",
      "selector": "custom:root_var_naming",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "landing"
      ],
      "category": "css.variables",
      "description": "landing 프로젝트는 :root에 --padding, --header_h, --width, --point-color-1 4개 변수가 모두 존재해야 한다.",
      "id": "root_vars_required",
      "pattern": "--padding,--header_h,--width,--point-color-1",
      "severity": "warning",
      "target": "css",
      "type": "required_substring"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.selector",
      "custom_handler": "check_excessive_individual_classes",
      "description": "같은 접두사 클래스가 8개 이상이면 부모+태그 셀렉터로 축소를 검토한다.",
      "id": "excessive_individual_classes",
      "selector": "custom:check_excessive_individual_classes",
      "severity": "info",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.selector",
      "custom_handler": "check_duplicate_selectors",
      "description": "같은 셀렉터를 미디어쿼리 밖에서 중복 선언하지 않는다 (한 번만 선언).",
      "id": "no_duplicate_selector",
      "selector": "custom:check_duplicate_selectors",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.selector",
      "description": ".font_serif, .weight_bold 같은 유틸리티 클래스를 사용하지 않는다 — 부모 셀렉터에서 직접 처리.",
      "id": "no_utility_classes",
      "pattern": "\\.(font|weight|color|size)_",
      "severity": "warning",
      "target": "css",
      "type": "regex_must_not_match"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.selector",
      "custom_handler": "selector_scoped",
      "description": "셀렉터는 페이지/섹션 스코프 안에 작성한다 (전역 단일 클래스 셀렉터 지양).",
      "id": "selector_scoped",
      "selector": "custom:selector_scoped",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.typography",
      "custom_handler": "_check_font_family_redundant",
      "description": "동일 font-family fallback 체인이 *, body, 개별 selector에 과다 반복되면 중복으로 간주한다.",
      "id": "font_family_redundant",
      "selector": "custom:_check_font_family_redundant",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "basic"
      ],
      "category": "css.typography",
      "description": "html,body에 font-size: clamp(14px, 1.2vw, 16px) 기준 선언이 필요하다 (basic 프로젝트).",
      "id": "font_size_base",
      "pattern": "font-size:clamp(",
      "severity": "warning",
      "target": "css",
      "type": "required_substring"
    },
    {
      "applies_to": [
        "landing"
      ],
      "category": "css.typography",
      "description": "landing 프로젝트: 모든 font-size는 PC/모바일 모두 고정 px만 사용 (rem 사용 금지).",
      "id": "font_size_landing_px",
      "pattern": "font-size\\s*:\\s*[\\d.]+rem",
      "severity": "warning",
      "target": "css",
      "type": "regex_must_not_match"
    },
    {
      "applies_to": [
        "basic"
      ],
      "category": "css.typography",
      "custom_handler": "check_font_size_base",
      "description": "basic 프로젝트: PC font-size는 rem 단위, 모바일(@media max-width:768px)에서만 px 사용.",
      "id": "font_size_pc_rem",
      "selector": "custom:check_font_size_base",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.typography",
      "custom_handler": "_check_landing_unit_mixed_scale",
      "description": "landing 프로파일에서 html/body font-size에 clamp|vw|rem|calc 혼용을 금지한다.",
      "id": "landing_unit_mixed_scale",
      "selector": "custom:_check_landing_unit_mixed_scale",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.typography",
      "custom_handler": "check_letter_spacing_unit",
      "description": "letter-spacing은 em 단위를 사용한다. px는 절대값 2px 이하 미세 조정 시에만 허용.",
      "id": "letter_spacing_unit",
      "selector": "custom:check_letter_spacing_unit",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.typography",
      "description": "line-height는 무단위 비율(1.3, 1.45)만 사용한다. 25.866px 같은 computed px 금지.",
      "id": "line_height_ratio_only",
      "pattern": "line-height\\s*:\\s*[\\d.]+px",
      "severity": "error",
      "target": "css",
      "type": "regex_must_not_match"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.typography",
      "custom_handler": "_check_line_height_tidy_ratio",
      "description": "line-height 무단위 비율은 정돈 후보 목록(1.0, 1.1, 1.2, 1.25, 1.3, 1.4, 1.45, 1.5, 1.6, 1.667, 1.75, 1.8, 2.0) 중 하나를 사용한다.",
      "id": "line_height_tidy_ratio",
      "selector": "custom:_check_line_height_tidy_ratio",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.typography",
      "custom_handler": "manual_review",
      "description": "다중행 말줄임 패턴은 -webkit-line-clamp 등 표준 패턴을 사용한다 (수동 시각 비교 필요).",
      "id": "multiline_ellipsis_pattern",
      "selector": "custom:manual_review",
      "severity": "info",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.typography",
      "description": "한국어 텍스트 단락/헤딩에는 word-break: keep-all을 적용한다.",
      "id": "word_break_korean",
      "pattern": "keep-all",
      "severity": "warning",
      "target": "css",
      "type": "required_substring"
    },
    {
      "applies_to": [
        "common",
        "figma"
      ],
      "category": "css.border",
      "description": "CSS border-* 속성은 Figma 노드에 visible stroke가 있을 때만 작성한다.",
      "id": "border_from_stroke_only",
      "pattern": "border<-strokes",
      "severity": "error",
      "target": "css",
      "type": "value_equals_mapping"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.border",
      "description": "border-radius는 원형 50%, pill 2em을 사용한다. 999px는 금지.",
      "id": "border_radius_no_999",
      "pattern": "999px",
      "severity": "error",
      "target": "css",
      "type": "forbidden_substring"
    },
    {
      "applies_to": [
        "common",
        "figma"
      ],
      "category": "css.border",
      "description": ".item+.item{border-left/top:...} 패턴 금지 — 대신 divider 노드를 DOM 요소로 사용한다.",
      "id": "no_adjacent_selector_border",
      "pattern": "\\+\\s*\\.[a-z0-9_-]+\\s*\\{[^}]*border-(left|top|right|bottom)",
      "severity": "error",
      "target": "css",
      "type": "regex_must_not_match"
    },
    {
      "applies_to": [
        "common",
        "figma"
      ],
      "category": "css.border",
      "description": "레이아웃 패턴이나 .card+.card 같은 인접 셀렉터로 border를 추측해 넣지 않는다.",
      "id": "no_heuristic_border",
      "pattern": "\\.[a-z0-9_-]+\\s*\\+\\s*\\.[a-z0-9_-]+\\s*\\{[^}]*border",
      "severity": "error",
      "target": "css",
      "type": "regex_must_not_match"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.spacing",
      "custom_handler": "check_large_side_padding",
      "description": "좌우 padding 100px 이상이면 max-width + margin:auto 패턴으로 변환해야 한다.",
      "id": "large_side_padding",
      "selector": "custom:check_large_side_padding",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.spacing",
      "custom_handler": "check_max_width_pattern",
      "description": "좌우 padding 100px 이상이 발견되면 max-width 기반 레이아웃 패턴 사용을 권장한다.",
      "id": "max_width_pattern",
      "selector": "custom:check_max_width_pattern",
      "severity": "warning",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "basic"
      ],
      "category": "css.spacing",
      "custom_handler": "mobile_spacing_half",
      "description": "basic 프로젝트 768px 이하: padding/margin은 PC 값의 약 절반 사용.",
      "id": "mobile_spacing_half",
      "selector": "custom:mobile_spacing_half",
      "severity": "info",
      "target": "css",
      "type": "custom"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.structure",
      "description": "내부 wrapper div는 최대 1개로 제한한다 (불필요한 중첩 금지).",
      "id": "inner_wrapper_limit",
      "pattern": "inner_wrapper<=1",
      "severity": "warning",
      "target": "html",
      "type": "numeric_range"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.structure",
      "description": "DOM 최대 깊이는 5단계를 초과하지 않는다.",
      "id": "max_dom_depth",
      "pattern": "depth<=5",
      "rationale": "과도한 wrapper 중첩 방지로 마크업 단순화",
