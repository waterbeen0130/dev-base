  "rules": [
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.structure",
      "description": "DOM 최대 깊이는 5단계를 초과하지 않는다.",
      "id": "max_dom_depth",
      "severity": "warning",
      "target": "html",
      "type": "numeric_range",
      "pattern": "depth<=5",
      "priority": 200,
      "rationale": "과도한 wrapper 중첩 방지로 마크업 단순화"
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "HTML 클래스명은 snake_case 만 사용한다 (kebab-case, camelCase 금지).",
      "id": "snake_case_naming",
      "severity": "warning",
      "target": "html",
      "type": "naming_pattern",
      "pattern": "^[a-z0-9_]+$",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "페이지 prefix는 섹션 컨테이너에만 부여한다 ({페이지}_{역할} 패턴, 예: main_intro, main_product). index.html은 main_ prefix를 사용한다. 기타 서브페이지는 파일명이 prefix (greeting.html → greeting_). 자식 요소는 짧은 역할명(.card, .list, .title_area)으로 선언하고 CSS는 .main_intro .card 형태로 부모 스코핑한다. 자식에 부모 prefix를 중첩하지 않는다 (.main_intro_card 금지 → .main_intro .card). 공통 영역(header/footer/gnb/logo/container/utils/sns)은 prefix 없이 사용.",
      "id": "page_prefix_required",
      "severity": "warning",
      "target": "html",
      "type": "naming_pattern",
      "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "sec_1, sec_2, section_01 같은 범용 클래스명을 금지한다.",
      "id": "no_forbidden_class",
      "severity": "error",
      "target": "html",
      "type": "forbidden_substring",
      "pattern": "sec_\\d+|section_\\d+|box\\d+",
      "priority": 100,
      "examples": {
        "bad": "<section class=\"sec_3\"><div class=\"box5\">",
        "good": "<section class=\"about_intro\">"
      }
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.selector",
      "description": "공통영역 자식 클래스(.logo, .gnb, .utils, .sns, .copyright, .logo_txt 등)는 .header/.footer 부모 셀렉터와 함께 선언한다. 단독 선언(.logo{}, .gnb a{})은 header/footer 양쪽 충돌 위험으로 금지.",
      "id": "common_area_child_scope",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_common_area_child_scope",
      "selector": "custom:check_common_area_child_scope",
      "priority": 200,
      "examples": {
        "bad": ".logo{...}  /  .gnb a{...}",
        "good": ".header .logo{...}  /  .header .gnb a{...}"
      }
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.selector",
      "description": "전역 클래스(.header, .footer, .cont, .img_area)는 body/html 등 부모를 붙이지 않고 단독 선언한다. 섹션 레벨 오버라이드(.main_intro .cont)는 허용.",
      "id": "global_class_standalone",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_global_class_standalone",
      "selector": "custom:check_global_class_standalone",
      "priority": 200,
      "examples": {
        "bad": "body .header{...}  /  html .cont{...}",
        "good": ".header{...}  /  .cont{...}  /  .main_intro .cont{...}"
      }
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "description": "CSS 주석은 영어만 사용한다 (한국어 주석 금지). /* */ 블록 내 한글을 검출.",
      "id": "no_korean_css_comment",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_korean_css_comment",
      "selector": "custom:check_korean_css_comment",
      "priority": 300,
      "examples": {
        "bad": "/* 헤더 영역 */",
        "good": "/* header area */"
      }
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "site_, g_, common_ 같은 추측성 prefix 클래스를 금지한다. 공통영역은 prefix 없이(.header), 페이지 콘텐츠는 파일명 기반 prefix(main_, greeting_)를 사용한다.",
      "id": "no_guess_prefix",
      "severity": "warning",
      "target": "html",
      "type": "forbidden_substring",
      "pattern": "\\b(site_|g_|common_)[a-z]",
      "priority": 200,
      "examples": {
        "bad": "<div class=\"site_header\"><span class=\"common_wrap\">",
        "good": "<div class=\"header\"><span class=\"main_intro\">"
      }
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "Figma 노드명을 그대로 박은 클래스(main_f0, main_v53, main_t12, hero_v2 같은 {접두}_{f|v|t}{숫자} 패턴)를 금지한다. 디자이너 레이어 식별자이며 시맨틱 의미가 없다. 페이지 prefix + 역할명(main_intro, greeting_title)을 사용한다.",
      "id": "no_figma_nodeid_class",
      "severity": "error",
      "target": "html",
      "type": "forbidden_substring",
      "pattern": "[a-z]+_[fvt][0-9]+",
      "priority": 100,
      "examples": {
        "bad": "<div class=\"main_f0\"><span class=\"main_v53\"><p class=\"main_t12\">",
        "good": "<div class=\"main_intro\"><span class=\"main_visual\">"
      }
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "sec_숫자, section_숫자, box숫자 같은 범용 클래스명을 모두 금지한다.",
      "id": "generic_class_name",
      "severity": "error",
      "target": "html",
      "type": "regex_must_not_match",
      "pattern": "(sec_\\d+|section_\\d+|box\\d+)\"",
      "priority": 100
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "의미 있는 영문 페이지명을 위해 HTML 파일명 + 본문(class/markup) 모두에서 page_1/sub_01 같은 기계식 이름을 금지한다.",
      "id": "meaningful_page_name",
      "severity": "error",
      "target": "html",
      "type": "regex_must_not_match",
      "pattern": "(page_\\d+|sub_\\d+|page_[a-z]$)",
      "priority": 100
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "CSS 클래스 프리픽스는 HTML 파일명과 일치해야 한다 (greeting.html → greeting_).",
      "id": "page_filename_class_prefix_match",
      "severity": "warning",
      "target": "html",
      "type": "custom",
      "custom_handler": "page_filename_class_prefix_match",
      "selector": "custom:page_filename_class_prefix_match",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "body 태그에 class 속성을 추가하지 않는다 — body는 공통 영역이므로 페이지별 class 금지.",
      "id": "no_body_class",
      "severity": "error",
      "target": "html",
      "type": "regex_must_not_match",
      "pattern": "<body[^>]*\\bclass\\s*=",
      "priority": 100
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "html.naming",
      "description": "header/footer/gnb/logo/container/utils/sns/copyright 같은 공통 영역에 페이지 프리픽스를 사용하지 않는다. 공통 영역은 어떤 페이지(index.html, greeting.html 등)에 있어도 prefix 없이 사용한다. 이 규칙은 page_prefix_required 보다 항상 우선한다.",
      "id": "common_area_prefix",
      "severity": "error",
      "target": "html",
      "type": "custom",
      "custom_handler": "check_common_area_prefix",
      "selector": "custom:check_common_area_prefix",
      "priority": 100,
      "examples": {
        "bad": ".index_header, .main_footer, .sub_container, .index_gnb",
        "good": ".header, .footer, .container, .gnb (모든 페이지에서 prefix 없이 동일)"
      }
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "description": "각 CSS 셀렉터 규칙은 한 줄로 작성한다 (여러 줄 펼침 금지). 콤마 셀렉터 3개 이상이면 셀렉터만 줄바꿈, 속성은 마지막 셀렉터 뒤에 한 줄로 붙인다.",
      "id": "selector_single_line",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_selector_format",
      "selector": "custom:check_selector_format",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.selector",
      "description": "같은 셀렉터를 미디어쿼리 밖에서 중복 선언하지 않는다 (한 번만 선언).",
      "id": "no_duplicate_selector",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_duplicate_selectors",
      "selector": "custom:check_duplicate_selectors",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "description": "@media 내부 규칙은 줄바꿈 분리하되 들여쓰기 없이 작성한다. 한 줄에 모든 규칙을 이어붙이지 않는다.",
      "id": "media_query_format",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_media_indent",
      "selector": "custom:check_media_indent",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "description": "@media 블록 내부 규칙에 들여쓰기를 사용하지 않는다.",
      "id": "no_media_indent",
      "severity": "info",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_media_indent",
      "selector": "custom:check_media_indent",
      "priority": 300
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.format",
      "description": "@media 블록 본문이 공백/주석뿐이면 빈 블록으로 간주하고 금지한다 (@media print 예외).",
      "id": "empty_media_block",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "_check_empty_media_block",
      "selector": "custom:_check_empty_media_block",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.units",
      "description": "100px 미만 값에는 clamp()를 사용하지 않는다 (고정 px). 100px 이상만 clamp 허용.",
      "id": "clamp_threshold",
      "severity": "info",
      "target": "css",
      "type": "regex_must_not_match",
      "pattern": "clamp\\(\\s*([0-9]|[1-9][0-9])px",
      "priority": 300
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.units",
      "description": "padding/margin에 100px 미만 clamp()를 사용하지 않는다.",
      "id": "no_clamp_under_100",
      "severity": "info",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_clamp_under_100",
      "selector": "custom:check_clamp_under_100",
      "priority": 300
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.units",
      "description": "calc()는 clamp() 내부에서만 사용한다. 단독 사용 금지.",
      "id": "no_raw_calc",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_raw_calc_vw",
      "selector": "custom:check_raw_calc_vw",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.units",
      "description": "vw 단위는 clamp() 내부에서만 사용한다. 단독 사용 금지.",
      "id": "no_raw_vw",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_raw_calc_vw",
      "selector": "custom:check_raw_calc_vw",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.spacing",
      "description": "좌우 padding 100px 이상이면 max-width + margin:auto 패턴으로 변환해야 한다.",
      "id": "large_side_padding",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_large_side_padding",
      "selector": "custom:check_large_side_padding",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.spacing",
      "description": "좌우 padding 100px 이상이 발견되면 max-width 기반 레이아웃 패턴 사용을 권장한다.",
      "id": "max_width_pattern",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_max_width_pattern",
      "selector": "custom:check_max_width_pattern",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.color",
      "description": "색상은 hex 전용 (#fff, #090944). rgb()/hsl() 금지. 투명도 필요 시만 rgba() 허용.",
      "id": "hex_color_only",
      "severity": "error",
      "target": "css",
      "type": "regex_must_not_match",
      "pattern": "(?<!rgba)\\brgb\\(|hsl\\(",
      "priority": 100,
      "examples": {
        "bad": "color: rgb(255,255,255);",
        "good": "color: #fff;"
      }
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.color",
      "description": "8자리 hex 리터럴(#RRGGBBAA)은 사용하지 않는다 (주석 및 url(data:) 내부는 제외).",
      "id": "no_hex8_literal",
      "severity": "warning",
      "target": "css",
      "type": "custom",
      "custom_handler": "_check_no_hex8_literal",
      "selector": "custom:_check_no_hex8_literal",
      "priority": 200
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.layout",
      "description": "레이아웃은 flexbox만 사용한다 (Grid/float 금지).",
      "id": "flexbox_layout",
      "severity": "error",
      "target": "css",
      "type": "regex_must_not_match",
      "pattern": "display\\s*:\\s*grid|float\\s*:\\s*(left|right)",
      "priority": 100
    },
    {
      "applies_to": [
        "common",
        "basic",
        "landing"
      ],
      "category": "css.layout",
      "description": "flex-direction:column 컨테이너에서는 gap을 사용하지 않는다 (수직 간격은 margin 사용).",
      "id": "no_column_flex_gap",
      "severity": "error",
      "target": "css",
      "type": "custom",
      "custom_handler": "check_no_column_gap",
      "selector": "custom:check_no_column_gap",
      "priority": 100
    },
    {
